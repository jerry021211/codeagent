# Required: Anthropic-compatible model identifier.
MODEL_ID=deepseek-v4-pro

# Required when using a hosted model API.
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: custom Anthropic-compatible endpoint.
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic

# Optional runtime settings.
MAX_TOKENS=8000
MAX_ITERATIONS=50
# Recommended for the Web cockpit so text_delta events arrive in real time.
STREAMING=true
CODEAGENT_PLANNING_MODE=auto
# Maximum concurrent Web root runs; 1 restores serial execution. Team workers are separate.
CODEAGENT_WEB_MAX_CONCURRENT_RUNS=4

# Single-agent loop protection (normal, discuss, ordinary subagents; not Team).
# Initial tuning values; positive except retries, retry delay and token cap may be 0.
CODEAGENT_LOOP_WINDOW=12
CODEAGENT_LOOP_REPEAT_FAILURE_LIMIT=3
CODEAGENT_LOOP_PARAMETER_ERROR_LIMIT=2
CODEAGENT_LOOP_BLOCKED_ATTEMPT_LIMIT=3
CODEAGENT_LOOP_EMPTY_RESPONSE_LIMIT=2
CODEAGENT_LOOP_TOOL_MAX_RETRIES=2
CODEAGENT_LOOP_RETRY_DELAY_SECONDS=0.25
CODEAGENT_RUN_MAX_MODEL_CALLS=80
CODEAGENT_RUN_MAX_TOOL_CALLS=200
# Reported input + cache creation/read + output tokens; 0 disables only this cap.
CODEAGENT_RUN_MAX_TOTAL_TOKENS=300000
CODEAGENT_RUN_MAX_ACTIVE_SECONDS=1800

# Optional MCP client config. A missing file simply disables MCP.
MCP_CONFIG=mcp.json

# Optional runtime system prompt assembly settings.
PROMPT_TEMPLATE_DIR=.prompts
SYSTEM_PROMPT_BUDGET_CHARS=120000
SYSTEM_PROMPT_STATIC_BUDGET_CHARS=50000
SYSTEM_PROMPT_DYNAMIC_BUDGET_CHARS=70000
SKILL_CATALOG_BUDGET_CHARS=12000
PROMPT_TRACE=false

# Optional error recovery settings.
RECOVERY_ENABLED=true
FALLBACK_MODEL_ID=
RECOVERY_TRACE=false

# Optional LangSmith tracing settings.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=CodeAgent
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# Shell subprocesses do not inherit tracing by default, avoiding orphan test/probe traces.
CODEAGENT_TRACE_SUBPROCESSES=false
# Optional: max characters per traced string field before local truncation.
LANGSMITH_TRACE_MAX_STRING_CHARS=20000

# Shared skill library for all projects and workspaces.
# Relative paths resolve under CODEAGENT_DATA_DIR; absolute paths are also supported.
ENABLE_SKILLS=true
SKILLS_DIR=skills

# Optional long-term memory settings.
ENABLE_MEMORY=true
MEMORY_DIR=.memory
MEMORY_MAX_ITEMS_IN_PROMPT=50
MEMORY_MAX_LOADED_ITEMS=5
MEMORY_SESSION_BUDGET_CHARS=60000
MEMORY_MAX_MEMORY_BYTES=50000
MEMORY_SELECTION_MODE=llm
MEMORY_AUTO_EXTRACT=false
MEMORY_EXTRACT_RECENT_MESSAGES=12
MEMORY_CONSOLIDATE_THRESHOLD=30
MEMORY_CONSOLIDATE_MODE=simple
MEMORY_ALLOW_SUBAGENT_WRITE=false

# CodeAgent-owned state, memory, context artifacts, and relative Team Worktrees
# live outside user Git repositories. Override this root when needed.
CODEAGENT_DATA_DIR=

# Optional context compaction settings.
CONTEXT_COMPACT_MODE=model
SUMMARIZATION_MODEL_ID=your-summary-model
SUMMARIZATION_API_KEY=your-summary-api-key
CONTEXT_TOOL_RESULT_BUDGET_CHARS=200000
CONTEXT_SINGLE_TOOL_OUTPUT_MAX_CHARS=80000
CONTEXT_COMPACT_THRESHOLD_CHARS=300000
# Characters, not tokens; retry oversized output once.
CONTEXT_SUMMARY_MAX_CHARS=4000
CONTEXT_TRANSCRIPT_DIR=.transcripts
CONTEXT_TOOL_OUTPUT_DIR=.task_outputs/tool-results
CONTEXT_REACTIVE_RETRIES=1
# Retain complete recent conversation messages / assistant execution rounds.
CONTEXT_RECENCY_MESSAGES=12
CONTEXT_RECENCY_ROUNDS=2
CONTEXT_MIN_FOLD_MESSAGES=4
CONTEXT_MAX_FOLD_MESSAGES=200
CONTEXT_MAX_FOLD_ROUNDS=12
# Complete serialized request budgets, including system and tool schemas.
CONTEXT_MAX_REQUEST_CHARS=600000
CONTEXT_SUMMARY_INPUT_MAX_CHARS=120000
# 0 = unknown model window: enforce characters, do not guess a provider window.
# When using fallback models, set the minimum supported window across them.
CONTEXT_WINDOW_TOKENS=0
CONTEXT_SUMMARY_WINDOW_TOKENS=0
# Optional per-model windows, including smaller fallback models. Values are tokens.
CONTEXT_MODEL_WINDOWS_JSON={}
CONTEXT_NEAR_CONTEXT_RATIO=0.8
CONTEXT_SUMMARY_TEXT_PREVIEW_CHARS=4000
CONTEXT_SUMMARY_ARGUMENT_PREVIEW_CHARS=2000
CONTEXT_FAILURE_COOLDOWN_SECONDS=90
CONTEXT_SUMMARY_TIMEOUT_SECONDS=45
# Pressure-driven tool cleanup is independent of semantic summary mode.
# Legacy MESSAGE_TRIGGER_MIN_FOLD / ROUND_TRIGGER_MIN_FOLD values are accepted but ignored.
CONTEXT_TOOL_PROJECTION_ENABLED=true
CONTEXT_INVESTIGATION_KEEP_ROUNDS=2
CONTEXT_COMMAND_KEEP_ROUNDS=1
CONTEXT_WRITE_KEEP_ROUNDS=2
CONTEXT_TOOL_CLEAR_MIN_CHARS=8000
CONTEXT_WRITE_CLEAR_MIN_CHARS=8000
# Agent Team is opt-in. The write flag has no effect unless the runtime flag is enabled.
TEAM_RUNTIME_ENABLED=false
TEAM_WRITE_ENABLED=false
# Relative paths are resolved under CODEAGENT_DATA_DIR, never inside the source repository.
TEAM_WORKTREE_ROOT=.codeagent-worktrees
